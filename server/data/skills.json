  "_meta": {
    "source": "sfl.world/land/22/skills",
    "game_version": "Sunflower Land World v0.9.8",
    "purpose": "Complete skill catalogue for all skill groups. Each skill entry encodes its effects in a machine-readable format so the engine can compute farm-specific yields, cook times, XP, produce amounts etc. The 'selected' field reflects land/22 at time of capture — it is OVERRIDDEN at runtime by the live farm state returned from get_farm_state (farm.skills). This file is the source of truth for WHAT a skill does; the farm state tells you WHICH skills are active.",
    "effect_types": {
      "multiply": "Multiply a numeric value by `value`. E.g. growTimeMultiplier: 0.9 means 10% faster.",
      "add": "Add `value` to a numeric output. E.g. yieldAdd: 0.1 means +0.1 per harvest.",
      "set": "Force a specific behaviour. E.g. tapCount: 1 means 1-tap interaction.",
      "chance": "A probabilistic bonus: `prob` chance of adding `bonus` to the output.",
      "aoe": "Extends area of effect of a collectible from its default radius to `tiles`x`tiles`.",
      "unlock": "Enables a feature or mechanic (no numeric value).",
      "stock_add": "Increases shop stock by `value` units.",
      "replace": "Replaces an input resource with another (see `from`, `to`)."
