# Postgres connection string (needs the pgvector extension installed — see schema.sql)
DATABASE_URL=postgres://user:password@localhost:5432/eldric

# Used by src/embed.js. Swap that whole file out if you're using a
# different embedding provider (Voyage, Cohere, a local model, etc) —
# just make sure schema.sql's `vector(N)` dimension matches whatever
# you switch to.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
