{
  "name": "sunflower-ai",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "setup": "node setup.js",
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "test": "tsx --test \"server/tests/*.test.ts\" \"server/tests/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "kb:init": "node sfl-kb-ingest/sfl-kb-ingest/scripts/init-db.js",
    "kb:ingest-wiki": "node sfl-kb-ingest/sfl-kb-ingest/scripts/ingest.js knowledge-base/json/wiki-dump.jsonl",
    "kb:ingest-gamedata": "node sfl-kb-ingest/sfl-kb-ingest/scripts/ingest-gamedata.js knowledge-base/json/gamedata",
    "kb:ingest": "npm run kb:ingest-wiki && npm run kb:ingest-gamedata"
  },
  "dependencies": {
    "@types/ioredis": "^4.28.10",
    "@xenova/transformers": "^2.17.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.19.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.0",
    "tsx": "^4.19.2",
    "ua-parser-js": "^1.0.39",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "madge": "^8.0.0",
    "typescript": "^5.4.5"
  }
}
