# External APIs
SUNFLOWER_API_KEY=
SUNFLOWER_API_URL=https://api.sunflower-land.com
SUNFLOWER_FARM_ID=346853928974080
PRICES_API_URL=https://sfl.world/api/v1/prices
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_BASE_URL=https://api.justwoker.icu
CLAUDE_ANTHROPIC_VERSION=2023-06-01

# Infrastructure
# LOCAL (docker-compose) uses the values below.
# ON RENDER: do NOT use localhost. Set DATABASE_URL to your Render Postgres
#   *Internal* connection string (host looks like dpg-xxxxx-a, no .render.com),
#   and REDIS_URL to your Key Value instance's Internal URL.
#   If the app leaves DATABASE_URL unset it falls back to 127.0.0.1:5432 and
#   fails with `ECONNREFUSED 127.0.0.1:5432` — that is the symptom to watch for.
DATABASE_URL=postgres://sfl:sfl@localhost:5432/sunflower
# SSL is auto-detected: off for local/Internal URLs, on for *.render.com URLs.
# Override only if needed: DATABASE_SSL=true forces TLS, DATABASE_SSL=false forces plain TCP.
# DATABASE_SSL=
REDIS_URL=redis://localhost:6379
PORT=3000
NODE_ENV=production

# Security & Authentication
JWT_SECRET=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Resource Governance
INITIAL_AI_CREDITS=50

# Background Planning Scheduler (Slice 3)
# OFF by default; set to 'true' to run the 24/7 forward-model planner sweep in-process.
PLANNING_SCHEDULER_ENABLED=false
# Sweep cadence in ms (default 900000 = 15 minutes).
PLANNING_SCHEDULER_INTERVAL_MS=900000
